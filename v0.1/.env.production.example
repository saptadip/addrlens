# Template for /srv/addrlens/.env.production on the Hetzner box.
# Copy to /srv/addrlens/.env.production and fill in real values.
# NEVER commit the filled version. .env.production is git-ignored.

# --- App service ---
CITY=berlin
INFERENCE_URL=http://inference:8080
LOG_LEVEL=info

# --- WFS + amenities hot-path cache tunables ---
# Shared `app.core.cache.HOT_PATH` TTLCache. Every unique geocoded
# address eats ~40 slots (BOD + Overpass buckets across the four
# environmental layers), so a burst of ~100 unique addresses fills the
# default 4096 store before LRU eviction kicks in. Shrink on the
# 4 GB Hetzner box only if you see the process RSS climb; short TTL
# is safe because noise / air / heat layers republish infrequently.
#   APP_CACHE_SIZE   4096 entries — LRU eviction beyond
#   APP_CACHE_TTL_S  3600 s (1 hour)
# APP_CACHE_SIZE=4096
# APP_CACHE_TTL_S=3600

# --- /api/history cache tunables ---
# Shared `app.core.cache.HISTORY` TTLCache — kept separate from the hot
# path so a WFS traffic spike doesn't evict expensive LLM prose.
# Historic OSM features change on the order of months; the systemd timer
# refreshes the OSM snapshot weekly (Sunday 03:00). Leave defaults unless
# you have a specific reason.
#   HISTORY_CACHE_TTL_S   7 days — matches the OSM snapshot refresh cadence
#   HISTORY_CACHE_SIZE    1000 entries — ~500 KB memory, LRU eviction beyond
#   HISTORY_CACHE_GRID    3 decimal places on lat/lon → ~100 m cache cells
# HISTORY_CACHE_TTL_S=604800
# HISTORY_CACHE_SIZE=1000
# HISTORY_CACHE_GRID=3

# --- Cloudflare Tunnel ---
# Copy the token from Zero Trust → Networks → Tunnels → addrlens-prod
# (only the token from the "docker run ... --token eyJ..." snippet).
# REQUIRED — cloudflared exits at boot if unset.
TUNNEL_TOKEN=

# --- Sentry (EU / Frankfurt region) ---
# Two separate Sentry projects.
#
# Provisioning steps (do once):
#   1. sentry.io → sign up → when creating the account, pick the EU data
#      region (host domain will be `de.sentry.io` instead of `sentry.io`).
#      This keeps event data in Frankfurt, matching the Hetzner box location.
#   2. Create two Python-FastAPI projects: `addrlens-app`, `addrlens-inference`.
#   3. Copy each project's DSN into the matching var below. The DSN format is
#      https://<key>@<host>/<project> where <host> for EU accounts is
#      `<something>.ingest.de.sentry.io`.
#
# Leave EMPTY (not "TODO", not "REPLACE_ME") to disable Sentry — the init
# in app/main.py + inference/main.py is guarded on truthy DSN, so an unfilled
# placeholder would silently init the SDK with a bogus DSN and drop telemetry.
#
# GDPR posture (see the app/main.py Sentry block): send_default_pii is off,
# and a before_send hook redacts address query params and request bodies so
# an exception traceback attached to a lookup never carries a user's search
# to Sentry.
SENTRY_DSN_APP=
SENTRY_DSN_INFERENCE=
SENTRY_ENV=production

# --- Release tracking ---
# Written by ops/deploy/update.sh on each deploy — do not set manually.
GIT_SHA=

# --- Cloudflare Workers AI (remote inference for history) ---
# Optional. When both CF_ACCOUNT_ID and CF_WORKERS_AI_TOKEN are set, the
# templates listed in INFERENCE_REMOTE_TEMPLATES are served by CF's LLM
# instead of the local llama-cpp model. On any remote failure the request
# falls through to the local backend — the local Qwen container stays
# running as a warm spare, so a CF outage never breaks the endpoint.
#
# API token: dash.cloudflare.com/profile/api-tokens → Create Token →
#   Custom → Account permissions: Workers AI (Read).
# Account ID: top-right of any Workers page.
CF_ACCOUNT_ID=
CF_WORKERS_AI_TOKEN=
# Model id — see developers.cloudflare.com/workers-ai/models/ for the
# current catalog. `-fast` is CF's optimised Llama 3.1 8B variant; the
# docs may still list `-awq` as stable, but CF deprecated it 2026-05-30.
CF_MODEL_ID=@cf/meta/llama-3.1-8b-instruct-fast
# Comma-separated template names that route to CF. Anything not listed
# stays on the local backend. Default: history only.
INFERENCE_REMOTE_TEMPLATES=history

# --- Umami analytics (cookieless, self-hosted, GDPR-clean) ---
# The umami + umami-db services in docker-compose.prod.yml host the tracker
# UI. Umami is reachable via a second Cloudflare Tunnel Public Hostname
# (see docs/hetzner-deploy.md → Umami setup). Both env vars below MUST be
# set for the app's / handler to inject the tracker snippet; leave EMPTY
# to serve a tracker-free page (dev, or before Umami website registration).
#
# UMAMI_DB_PASSWORD  — Postgres password for Umami's database. Generate:
#                      openssl rand -hex 24
# UMAMI_APP_SECRET   — Umami session/JWT signing secret. Generate:
#                      openssl rand -hex 32
# UMAMI_WEBSITE_ID   — UUID assigned by Umami after registering addrlens.de
#                      in its UI. Copy from Umami → Settings → Websites →
#                      addrlens.de → "Tracking code" tab.
# UMAMI_SCRIPT_URL   — Absolute URL to the tracker script Umami serves.
#                      Typically https://umami.addrlens.de/script.js.
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=
