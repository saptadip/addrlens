# Template for /srv/addrlens/.env.production on the Hetzner box.
# Copy to /srv/addrlens/.env.production and fill in real values.
# NEVER commit the filled version. .env.production is git-ignored.

# --- App service ---
CITY=berlin
INFERENCE_URL=http://inference:8080
LOG_LEVEL=info

# --- /api/history cache tunables ---
# Historic OSM features change on the order of months; the systemd timer
# refreshes the OSM snapshot weekly (Sunday 03:00). Leave defaults unless
# you have a specific reason.
#   HISTORY_CACHE_TTL_S   7 days — matches the OSM snapshot refresh cadence
#   HISTORY_CACHE_SIZE    1000 entries — ~500 KB memory, LRU eviction beyond
#   HISTORY_CACHE_GRID    3 decimal places on lat/lon → ~100 m cache cells
# HISTORY_CACHE_TTL_S=604800
# HISTORY_CACHE_SIZE=1000
# HISTORY_CACHE_GRID=3

# --- Cloudflare Tunnel ---
# Copy the token from Zero Trust → Networks → Tunnels → addrlens-prod
# (only the token from the "docker run ... --token eyJ..." snippet).
# REQUIRED — cloudflared exits at boot if unset.
TUNNEL_TOKEN=

# --- Sentry (EU / Frankfurt region) ---
# Two separate Sentry projects. DSN format: https://<key>@<host>/<project>
# Leave EMPTY (not "TODO", not "REPLACE_ME") to disable Sentry — the init
# in app/main.py + inference/main.py is guarded on truthy DSN, so an unfilled
# placeholder would silently init the SDK with a bogus DSN and drop telemetry.
SENTRY_DSN_APP=
SENTRY_DSN_INFERENCE=
SENTRY_ENV=production

# --- Release tracking ---
# Written by ops/deploy/update.sh on each deploy — do not set manually.
GIT_SHA=

# --- Cloudflare Workers AI (remote inference for history) ---
# Optional. When both CF_ACCOUNT_ID and CF_WORKERS_AI_TOKEN are set, the
# templates listed in INFERENCE_REMOTE_TEMPLATES are served by CF's LLM
# instead of the local llama-cpp model. On any remote failure the request
# falls through to the local backend — the local Qwen container stays
# running as a warm spare, so a CF outage never breaks the endpoint.
#
# API token: dash.cloudflare.com/profile/api-tokens → Create Token →
#   Custom → Account permissions: Workers AI (Read).
# Account ID: top-right of any Workers page.
CF_ACCOUNT_ID=
CF_WORKERS_AI_TOKEN=
# Model id — see developers.cloudflare.com/workers-ai/models/ for the
# current catalog. `-fast` is CF's optimised Llama 3.1 8B variant; the
# docs may still list `-awq` as stable, but CF deprecated it 2026-05-30.
CF_MODEL_ID=@cf/meta/llama-3.1-8b-instruct-fast
# Comma-separated template names that route to CF. Anything not listed
# stays on the local backend. Default: history only.
INFERENCE_REMOTE_TEMPLATES=history
