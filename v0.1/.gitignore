.venv/
__pycache__/
*.pyc
.env
uv.lock
# GGUF model files baked into inference/ image — 1 GB each, keep out of git
models/*.gguf
# uv install leaks these when building with setuptools legacy backend
*.egg-info/
# uvicorn stdout capture (see README on running with tail -f)
logs/
# Playwright MCP scratch (per-QA browser data + ephemeral screenshots, §14.12)
.playwright-mcp/
*.qa.png
young-family-lens-qa-shipped.png

# Production runtime state — lives on the box, never in git
.env.production
/srv/

# Large binaries — kept out of the repo; fetched separately on the box
# (models/*.gguf already covered above)
data/osm/*.pbf
data/osm/berlin-amenities.json

# Local-dev docker compose override — mounts the host models/ + data/osm/
# into the containers; not used in prod (docker-compose.prod.yml handles that).
docker-compose.override.yml
