# Shared inference image (plan §7.1.1). Linux → llama-cpp-python + GGUF.
# One image, all cities. Model file is baked in for reproducible builds
# (§7.4); switch to a mounted volume only if image push time hurts.
#
# Build context = repo root (micro-service/). Build:
#   docker build -f ops/Dockerfile.inference -t addrlens-inference .
#
# Before building, download the GGUF into ./models/ (git-ignored):
#   mkdir -p models
#   hf download bartowski/Qwen2.5-1.5B-Instruct-GGUF \
#     Qwen2.5-1.5B-Instruct-Q4_K_M.gguf --local-dir models/
#
# ponytail: llama-cpp-python wheels ship with pre-built CPU binaries — no
# CMake / nvcc / build-essential needed in the image. If GPU is added later
# (Ship LLM-3), rebuild with LLAMA_CUBLAS=1 and switch base to nvidia/cuda.

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /srv

# ---- deps layer ----
COPY inference/pyproject.toml ./pyproject.toml
RUN uv pip install --system --no-cache ".[prod]"

# ---- inference code + model ----
COPY inference ./inference
# Bake the GGUF in — plan §7.4 default. Comment out + mount if you'd rather
# ship the model separately.
COPY models/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf /models/

RUN useradd -u 10001 -m -s /sbin/nologin addrlens \
    && chown -R addrlens:addrlens /srv /models
USER addrlens

ENV INFERENCE_BACKEND=llama \
    LLAMA_MODEL_PATH=/models/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf \
    PORT=8080 \
    PYTHONUNBUFFERED=1

EXPOSE 8080
# Longer start_period than the app: llama.cpp CPU model load is 10–20 s on
# a modest x86 core (plan §7.6). App-side /ready in Ship D gates traffic
# until this reports ready.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/ready', timeout=5)" || exit 1

CMD ["uvicorn", "inference.main:app", "--host", "0.0.0.0", "--port", "8080"]
