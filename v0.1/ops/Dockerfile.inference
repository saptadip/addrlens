# Shared inference image (plan §7.1.1). Two build targets:
#
#   - `remote` (DEFAULT) — Cloudflare Workers AI only. No local model
#     backend, no llama-cpp-python, no CMake / build-essential system
#     deps. ~150 MB smaller. Requires INFERENCE_LOCAL_BACKEND=off at
#     runtime (defaults to `off` in this stage's ENV). This is what
#     prod ships since Ship LLM-2.
#
#   - `local` — llama.cpp local backend (llama-cpp-python + CMake +
#     build-essential + a bind-mounted GGUF model). Kept as an escape
#     hatch for on-prem / air-gapped deployments and for local Linux
#     dev when the Apple-Silicon mlx path is not available.
#
# Build (default remote):
#   docker build -f ops/Dockerfile.inference -t addrlens-inference .
#
# Build the local-backend variant explicitly:
#   docker build -f ops/Dockerfile.inference --target local -t addrlens-inference:local .
#
# For the `local` variant, download the GGUF into ./models/ first
# (git-ignored):
#   mkdir -p models
#   hf download bartowski/Qwen2.5-1.5B-Instruct-GGUF \
#     Qwen2.5-1.5B-Instruct-Q4_K_M.gguf --local-dir models/

# ---- shared base ----------------------------------------------------
FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /srv

# Deps layer manifest — copied once, installed differently per target.
COPY inference/pyproject.toml ./pyproject.toml
# Prod-only: Sentry SDK. Init in inference/main.py is env-guarded so
# local dev (bare uvicorn on Apple Silicon) is unaffected.
RUN uv pip install --system --no-cache "sentry-sdk[fastapi]>=2.0"


# ---- local — llama-cpp-python + GGUF -------------------------------
# Escape hatch: on-prem / air-gapped / Linux-only dev. Adds ~150 MB
# for the compiled llama-cpp-python wheel + the build-essential deps
# it needs to install cleanly on ARM64 (x86_64 has pre-built wheels).
# Build explicitly with `docker build ... --target local`.
FROM base AS local

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake python3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN uv pip install --system --no-cache ".[prod]"

COPY inference ./inference
# Model file is bind-mounted at runtime from /srv/addrlens/models/ into
# /models/:ro (see docker-compose.override.yml for dev).
# The mountpoint must exist.
RUN mkdir -p /models

RUN useradd -u 10001 -m -s /sbin/nologin addrlens \
    && chown -R addrlens:addrlens /srv
USER addrlens

ENV INFERENCE_BACKEND=llama \
    LLAMA_MODEL_PATH=/models/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf \
    PORT=8080 \
    PYTHONUNBUFFERED=1

EXPOSE 8080
# Longer start_period: llama.cpp CPU model load is 10-20 s on a modest
# x86 core. App-side /ready in Ship D gates traffic until this reports
# ready.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/ready', timeout=5)" || exit 1

CMD ["uvicorn", "inference.main:app", "--host", "0.0.0.0", "--port", "8080"]


# ---- remote (DEFAULT) — Cloudflare Workers AI only ------------------
# LAST stage in the file → `docker build ...` with no --target lands
# here. This is the prod image since Ship LLM-2.
FROM base AS remote

RUN uv pip install --system --no-cache ".[remote]"

COPY inference ./inference

RUN useradd -u 10001 -m -s /sbin/nologin addrlens \
    && chown -R addrlens:addrlens /srv
USER addrlens

# INFERENCE_LOCAL_BACKEND=off skips the (non-existent, in this image)
# local loader entirely; every template must be in
# INFERENCE_REMOTE_TEMPLATES or /summarize returns 503 with a clear
# message. See v0.1/inference/main.py.
ENV INFERENCE_LOCAL_BACKEND=off \
    PORT=8080 \
    PYTHONUNBUFFERED=1

EXPOSE 8080
# Remote-only image warms instantly (no model load), so start_period
# can be short.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/ready', timeout=5)" || exit 1

CMD ["uvicorn", "inference.main:app", "--host", "0.0.0.0", "--port", "8080"]
